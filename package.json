{
  "name": "geekfz-docs",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "docs:dev": "vuepress dev docs",
    "docs:build": "vuepress build docs && cp ads.txt dist/ads.txt",
    "docs:test": "echo 1 && cp ads.txt dist/ads.txt",
    "docs:lint": "prettier --check --write docs/",
    "docs:clean-dev": "vuepress dev docs --no-cache"
  },
  "dependencies": {
    "vue": "^3.5.43",
    "vuepress": "2.0.0-rc.31",
    "vuepress-theme-hope": "2.0.0-rc.110"
  },
  "devDependencies": {
    "@rolldown/binding-darwin-arm64": "^1.2.12",
    "@vuepress/bundler-vite": "2.0.0-rc.31",
    "@vuepress/plugin-docsearch": "2.0.0-rc.137",
    "@vuepress/plugin-register-components": "2.0.0-rc.135",
    "@vuepress/plugin-revealjs": "2.0.0-rc.137",
    "@vuepress/plugin-search": "2.0.0-rc.137",
    "katex": "^0.18.10",
    "prettier": "2.8.4",
    "sass-embedded": "^1.105.1",
    "vuepress-plugin-components": "2.0.0-rc.110"
  },
  "packageManager": "pnpm@12.6.0",
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "@algolia/client-search"
      ]
    }
  }
}